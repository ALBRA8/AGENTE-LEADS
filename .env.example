# ============================================================
# AGENTE LEADS – Environment Variables Example
# ============================================================

# NVIDIA NIM API Key (get from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (whitelist)
ALLOWED_IDS=your_telegram_user_id

# SQLite database file path
DB_PATH=./data/agente-leads.db

# Agent settings
AGENT_NAME=AGENTE LEADS
MAX_TOOL_ITERATIONS=10

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Apify token (optional, for Apify scraping fallbacks)
APIFY_TOKEN=your_apify_token_here

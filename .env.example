# ============================================================
# AGENTE LEADS – Environment Variables Example
# ============================================================

# NVIDIA NIM API Key (GLM 5.3 Flash)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (whitelist)
ALLOWED_IDS=your_telegram_user_id

# SQLite database paths
DB_PATH=./data/agente-leads.db
LEADS_DB_PATH=./data/lead-intelligence.db

# Agent settings
AGENT_NAME=AGENTE LEADS
MAX_TOOL_ITERATIONS=10
LOG_LEVEL=info

# Apify token (optional, for Apify scraping fallbacks)
APIFY_TOKEN=your_apify_token_here

# ── P2.1 — Email outreach (SendGrid) ─────────────────────────
# Get API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=ventas@tuempresa.com

# ── P2.2 — WhatsApp Cloud API (Meta) ─────────────────────────
# Get from https://developers.facebook.com/apps/ (WhatsApp Cloud API)
WHATSAPP_TOKEN=your_whatsapp_cloud_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ── P2.3 — CRM-ALBRA webhook (optional) ─────────────────────
# URL of the receiving CRM. Leave empty to disable.
CRM_ALBRA_WEBHOOK_URL=
CRM_ALBRA_SECRET=
